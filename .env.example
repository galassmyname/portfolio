# Copy this file to .env and fill in the values. On your host (Vercel, Netlify…),
# add the same variables in the project's environment settings.

# Contact form — Web3Forms (https://web3forms.com)
# Create an access key for serignefalloumbaye2002@gmail.com and paste it here.
VITE_WEB3FORMS_ACCESS_KEY=

# Public address of the deployed site — used for canonical URLs, hreflang,
# Open Graph, JSON-LD, sitemap.xml and robots.txt. No trailing slash.
# Format: https://www.your-domain.com
VITE_SITE_URL=

# Only if the site is served from a sub-folder (e.g. a GitHub Pages project page: /portfolio/).
# Leave empty for a domain root.
VITE_BASE_PATH=

# Optional: Google Search Console "HTML tag" verification — paste only the content="…" value.
VITE_GOOGLE_SITE_VERIFICATION=
